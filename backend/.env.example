# Copy to `.env`; `make run` loads it.

# ─── 42 OAuth app (required) ── https://profile.intra.42.fr/oauth/applications
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# Where users open the app. The frontend and this API must share this origin
# (Vite dev proxy locally, a reverse proxy in production). Cookies get the
# Secure flag when it is https.
PUBLIC_URL=http://localhost:5173

# OAuth callback page of the app; register it on the 42 app. Defaults to:
# FT_REDIRECT_URI=${PUBLIC_URL}/auth/callback

# FT_API_BASE=https://api.intra.42.fr
# 42 API request limits for this app, shared by every backend call
# FT_RATE_PER_SECOND=2
# FT_RATE_PER_HOUR=1200

# ─── Optional (defaults shown) ───────────────────────────────────────────────

# Address the HTTP server listens on
HTTP_ADDR=:8080

# SQLite database file (created with its directory if missing)
DATABASE_PATH=./data/app.db

# debug | info | warn | error
LOG_LEVEL=info

# How long a sign-in lasts
SESSION_TTL=720h

# A student's stored data older than this is refreshed from 42 before the API
# returns it (profile pages, /me)
STUDENT_MAX_AGE=2m

# How often registered students are re-synced from 42 in the background (Go
# duration: 30m, 1h, 6h). Runs once at startup too. 0 disables it.
SYNC_INTERVAL=1h
# Only students whose last sync (login, profile view or background sync) is at
# least this old are synced by a run. 0 syncs everyone every run.
SYNC_MAX_AGE=24h
