# Copy to `.env`; `make run` loads it.

# ─── 42 OAuth app (required) ── https://profile.intra.42.fr/oauth/applications
FT_CLIENT_ID=
FT_CLIENT_SECRET=
# Must match VITE_42_REDIRECT_URI in the frontend and be registered on the 42 app
FT_REDIRECT_URI=http://localhost:5173/auth/callback
# FT_API_BASE=https://api.intra.42.fr
# 42 API request limits for this app, shared by logins and the background sync
# FT_RATE_PER_SECOND=2
# FT_RATE_PER_HOUR=1200

# ─── Optional (defaults shown) ───────────────────────────────────────────────

# Address the HTTP server listens on
HTTP_ADDR=:8080

# SQLite database file (created with its directory if missing)
DATABASE_PATH=./data/app.db

# Comma-separated list of origins allowed to call the API (the frontend)
CORS_ALLOW_ORIGINS=http://localhost:5173

# debug | info | warn | error
LOG_LEVEL=info

# How often every registered student's progress is re-synced from 42 (Go
# duration: 30m, 1h, 6h). Runs once at startup too. 0 disables it.
SYNC_INTERVAL=1h
# Only students whose last sync (at login or by the background sync) is at
# least this old are synced by a run. 0 syncs everyone every run.
SYNC_MAX_AGE=24h
