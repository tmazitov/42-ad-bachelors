# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
# Copy to `.env` for local dev:  cp .env.example .env
# NOTE: every VITE_* value is inlined into the public JS bundle. Never put a
# production secret in a VITE_* var.

# 42 OAuth app UID (https://profile.intra.42.fr/oauth/applications)
VITE_42_CLIENT_ID=

# 42 OAuth app secret. DEV ONLY: used only when VITE_42_TOKEN_PROXY is empty
# (token exchange goes straight to 42 through the Vite dev proxy).
VITE_42_CLIENT_SECRET=

# Must exactly match a redirect URI registered on the 42 OAuth app
VITE_42_REDIRECT_URI=http://localhost:5173/auth/callback

# Base URL for 42 API calls (/v2/...). Leave empty in dev so that the Vite
# proxy (vite.config.ts) forwards /v2 and /oauth to https://api.intra.42.fr.
# In production this points at the backend (currently the Cloudflare Worker).
VITE_42_API_BASE=

# Full URL of the token-exchange endpoint, ending in /oauth/token.
# If set, code exchange and refresh go through it (the server holds the secret).
# The refresh URL is derived by replacing /oauth/token with /oauth/refresh.
# Example: https://42-ad-bachelors-auth.<subdomain>.workers.dev/oauth/token
VITE_42_TOKEN_PROXY=

# Optional: base URL serving GET /leaderboard. Falls back to VITE_42_API_BASE.
VITE_WORKER_URL=

# ─── Cloudflare Worker (legacy, to be removed) ───────────────────────────────
# These are NOT read from .env. They are Worker secrets (`wrangler secret put`)
# or go in `.dev.vars` for `wrangler dev`:
#   CLIENT_ID=<same as VITE_42_CLIENT_ID>
#   CLIENT_SECRET=<42 OAuth app secret>
# CAMPUS_ID is set in wrangler.toml [vars] (currently unused by the code).
