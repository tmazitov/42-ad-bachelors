# Variables for compose.yaml. Copy to `.env` next to compose.yaml, or set
# them in Coolify's environment settings for this resource.

# The URL users open (https; Coolify handles the certificate).
# Register ${PUBLIC_URL}/auth/callback as the redirect URI of the 42 app.
PUBLIC_URL=https://bachelors.example.com

# Port nginx listens on inside the stack (Coolify's proxy forwards to it).
# NGINX_PORT=8088

# 42 OAuth app (required) — https://profile.intra.42.fr/oauth/applications
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# Optional (defaults shown); see backend/.env.example for what they do.
# SESSION_TTL=720h
# STUDENT_MAX_AGE=2m
# SYNC_INTERVAL=1h
# SYNC_MAX_AGE=24h
# FT_RATE_PER_SECOND=2
# FT_RATE_PER_HOUR=1200
# LOG_LEVEL=info
