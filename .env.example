# Variables for compose.yaml. Copy to `.env` next to compose.yaml.
# (42 credentials and backend tuning live in backend/.env.)

# Your domain. Caddy obtains an HTTPS certificate for it automatically: point
# the domain's DNS at the VPS and open ports 80 and 443.
# Use :80 for plain HTTP, e.g. when testing locally.
SITE_ADDRESS=bachelors.example.com

# The URL users open; must match SITE_ADDRESS (https:// for a domain).
# Register ${PUBLIC_URL}/auth/callback as the redirect URI of the 42 app.
PUBLIC_URL=https://bachelors.example.com

# Host ports (defaults 80 / 443)
# HTTP_PORT=80
# HTTPS_PORT=443
