# Public entry point of the stack. TLS is terminated before nginx (Coolify's
# proxy), which forwards plain HTTP here on ${NGINX_PORT}. Requests are routed
# by URL prefix:
#   /api/*  -> backend:8080 (path kept, the API lives under /api/v1)
#   /*      -> frontend:80  (static SPA)

# Keep the scheme reported by the TLS proxy; fall back to ours when reached directly.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen ${NGINX_PORT} default_server;
    server_name _;

    server_tokens off;
    client_max_body_size 1m;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_min_length 1024;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Docker's DNS; with variables in proxy_pass, upstreams are resolved per
    # request, so nginx starts even if one is down and follows restarts.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend http://backend:8080;
    set $frontend http://frontend:80;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;

    location /api/ {
        proxy_pass $backend;
    }

    location / {
        proxy_pass $frontend;
    }
}
